# 선택사항. 설정하면 Gemini가 인용 필요 여부·검색어·근거/모순 판단을 수행합니다 (Agentic 모드).
# Google AI Studio (https://aistudio.google.com/apikey)에서 무료로 발급 가능.
# 설정하지 않으면 휴리스틱(영문 전문용어 추출) 방식으로 후보 논문만 찾고 판단은 하지 않습니다 (미판정).
GEMINI_API_KEY=
# 기본값 gemini-flash-latest (최신 Flash 모델 별칭). 특정 버전을 쓰려면 모델명을 지정.
GEMINI_MODEL=gemini-flash-latest

# 선택사항. OpenAlex는 키가 필요 없지만, 이메일을 알려주면 "polite pool"로 분류되어
# 더 여유로운 요청 한도를 받을 수 있음 (https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication).
OPENALEX_MAILTO=

# 선택사항. OpenAlex API 키 (https://openalex.org/settings/api). 키 없이 요청이 거절/제한되면 설정.
OPENALEX_API_KEY=

# 선택사항. 설정하면 Semantic Scholar도 검색 대상에 추가 (키 없으면 429가 잦아 제외).
SEMANTIC_SCHOLAR_API_KEY=

# 한 번에 분석할 최대 문장 수 (API 비용·응답 시간 제한)
MAX_SENTENCES=30
