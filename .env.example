# 선택사항. 설정하면 Claude가 검색어 생성 및 근거 충분성 판단을 수행합니다 (Agentic 모드).
# 설정하지 않으면 휴리스틱(영문 전문용어 추출 + 검색결과 유무) 방식으로만 동작합니다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# 선택사항. OpenAlex는 키가 필요 없지만, 이메일을 알려주면 "polite pool"로 분류되어
# 더 여유로운 요청 한도를 받을 수 있음 (https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication).
OPENALEX_MAILTO=

# 선택사항. OpenAlex API 키 (https://openalex.org/settings/api). 키 없이 요청이 거절/제한되면 설정.
OPENALEX_API_KEY=

# 선택사항. 설정하면 Semantic Scholar도 검색 대상에 추가 (키 없으면 429가 잦아 제외).
SEMANTIC_SCHOLAR_API_KEY=

# 한 번에 분석할 최대 문장 수 (API 비용·응답 시간 제한)
MAX_SENTENCES=30
